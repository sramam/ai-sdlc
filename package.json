{
  "name": "ai-sdlc",
  "version": "0.2.1",
  "private": true,
  "description": "The ai-sdlc registry: the kit, its tooling and recipes, and the CLI that copies them into a project. No product code.",
  "type": "module",
  "bin": {
    "ai-sdlc": "scripts/registry/cli.mjs"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:local": "node tooling/ci/src/ci-local.mts",
    "plan:check": "node tooling/plan/src/plan-check.mts",
    "plan:status": "node tooling/plan/src/plan-status.mts",
    "item-check": "node tooling/plan/src/item-check.mts",
    "worktrees": "node tooling/guards/src/worktrees.mts",
    "db:local": "node tooling/localdb/src/cli.mts",
    "seed": "node tooling/seed/src/seed.mts",
    "accounts:check": "node tooling/setup/src/accounts-check.mts",
    "bootstrap": "node tooling/setup/src/bootstrap.mts",
    "usage": "node tooling/core/src/usage.mts",
    "sdlc:init": "node tooling/setup/src/sdlc-init.mts",
    "land": "node tooling/ci/src/land.mts",
    "claim": "node tooling/plan/src/claim.mts",
    "sources:add": "node tooling/guards/src/sources-manifest.mts --add",
    "sources:check": "node tooling/guards/src/sources-manifest.mts --check",
    "prose-check": "node tooling/guards/src/prose-check.mts",
    "journeys:learn": "node tooling/journeys/src/cli/learn.mts",
    "journeys:test": "node tooling/journeys/src/cli/run.mts",
    "journeys:delta": "node tooling/journeys/src/cli/delta.mts",
    "journeys:drift": "node tooling/journeys/src/cli/drift.mts",
    "journeys:index": "node tooling/journeys/src/cli/index.mts",
    "journeys:timing": "node tooling/journeys/src/cli/timing.mts",
    "coverage": "node tooling/coverage/src/coverage.mts",
    "coverage:report": "node tooling/coverage/src/coverage.mts --report",
    "promote:staging": "node tooling/promote/src/promote.mts staging",
    "promote:prod": "node tooling/promote/src/promote.mts production",
    "rollback": "node tooling/promote/src/rollback.mts",
    "release": "node tooling/promote/src/release.mts",
    "security:scan": "node tooling/security/src/scan.mts",
    "security:scan:staged": "node tooling/security/src/scan.mts --staged",
    "recipes:check": "node scripts/recipes-check.mts",
    "sdlc": "node scripts/registry/cli.mjs",
    "registry:check": "node scripts/registry/e2e.mts",
    "registry:patterns": "node scripts/registry/pattern-check.mts",
    "3rdparty": "node scripts/registry/third-party.mts"
  },
  "lint-staged": {
    "*.{ts,mts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write",
      "pnpm -w prose-check"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  }
}
