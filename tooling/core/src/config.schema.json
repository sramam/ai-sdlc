{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sdlc.config.json",
  "description": "The project's knobs for the ai-sdlc tooling. Declarative: read, validated and never executed (tooling/core/src/config.mts).",
  "type": "object",
  "properties": {
    "configVersion": {
      "type": "integer",
      "description": "The config format version; default 1. A release that changes the format raises it.",
      "minimum": 1
    },
    "branches": {
      "type": "object",
      "description": "Branch names, fixed: dev, staging and main. Kept so tools read one source; not configurable (tooling/core/src/config.mts FIXED_BRANCHES).",
      "properties": {
        "integration": {
          "type": "string",
          "enum": ["dev"]
        },
        "staging": {
          "type": "string",
          "enum": ["staging"]
        },
        "production": {
          "type": "string",
          "enum": ["main"]
        }
      },
      "required": ["integration", "staging", "production"],
      "additionalProperties": false
    },
    "dirs": {
      "type": "object",
      "properties": {
        "requirements": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "progress": {
          "type": "string",
          "minLength": 1
        },
        "adr": {
          "type": "string",
          "minLength": 1
        },
        "handoffs": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["requirements", "plan", "progress", "adr", "handoffs"],
      "additionalProperties": false
    },
    "claimStaleDays": {
      "type": "integer",
      "description": "Days without a commit before a claimed branch is reported as stale.",
      "minimum": 1
    },
    "cadence": {
      "type": "object",
      "properties": {
        "progressReportWeekdays": {
          "type": "array",
          "description": "0 = Sunday … 6 = Saturday.",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "planSyncDays": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["progressReportWeekdays", "planSyncDays"],
      "additionalProperties": false
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cli": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "The CLI binary, or null for a manual step."
          },
          "check": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manual": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "cli", "check"],
        "additionalProperties": false
      }
    },
    "ci": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "applies": {
                "type": "string",
                "enum": ["always", "has-apps", "has-packages", "has-source", "has-plan"]
              },
              "env": {
                "type": "array",
                "description": "Environment variables the step may see.",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "history": {
                "type": "boolean",
                "description": "Reads a commit range: runs even on a cache hit."
              },
              "unknownExitCodes": {
                "type": "array",
                "description": "Exit codes meaning the step could not run, not that it failed.",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                }
              }
            },
            "required": ["name", "run", "applies"],
            "additionalProperties": false
          }
        },
        "container": {
          "type": "object",
          "description": "Used by `ci:local --container`.",
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "engine": {
              "type": "string",
              "enum": ["docker", "podman"]
            },
            "network": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["image"],
          "additionalProperties": false
        }
      },
      "required": ["steps"],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "floors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "lines": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "branches": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": ["lines", "branches"],
            "additionalProperties": false
          }
        }
      },
      "required": ["floors"],
      "additionalProperties": false
    },
    "localdb": {
      "type": "object",
      "properties": {
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "migrate": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        }
      },
      "required": ["databases"],
      "additionalProperties": false
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "database": {
            "type": "string",
            "minLength": 1
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["app", "run"],
        "additionalProperties": false
      }
    },
    "environments": {
      "type": "object",
      "description": "Deployed environments by name, promoted with `pnpm promote <name>` (tooling/promote).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "string",
            "description": "The branch this environment deploys: branches.staging or branches.production.",
            "minLength": 1
          },
          "deploy": {
            "type": "string",
            "description": "Shell command, run in a clean checkout of the promoted SHA.",
            "minLength": 1
          },
          "migrate": {
            "type": "string",
            "description": "Shell command migrating this environment over its direct connection; runs before deploy.",
            "minLength": 1
          },
          "smokeUrl": {
            "type": "string",
            "description": "GET after the push; a status below 400 passes.",
            "minLength": 1
          },
          "smoke": {
            "type": "string",
            "description": "Shell command run after the push; exit 0 passes.",
            "minLength": 1
          },
          "rollback": {
            "type": "string",
            "description": "Shell command for `pnpm rollback <env>`. The schema stays forward.",
            "minLength": 1
          },
          "requiresApproval": {
            "type": "boolean",
            "description": "Promote prints the plan and requires --yes."
          }
        },
        "required": ["branch", "deploy"],
        "additionalProperties": false
      }
    },
    "release": {
      "type": "object",
      "description": "Version tags (`pnpm release`). Absent: tagPrefix \"v\".",
      "properties": {
        "tagPrefix": {
          "type": "string",
          "description": "Prefix of version tags, e.g. \"v\" for v1.2.3.",
          "pattern": "^[A-Za-z0-9._/-]*$"
        }
      },
      "required": ["tagPrefix"],
      "additionalProperties": false
    }
  },
  "required": ["branches", "dirs", "claimStaleDays", "cadence", "accounts", "ci", "coverage"],
  "additionalProperties": false
}
